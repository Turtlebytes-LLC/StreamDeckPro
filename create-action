#!/bin/bash
#
# create-action - scaffold a new StreamDeckPro action from a template.
#
#   ./create-action --template app-launch --target button-3 --label "Files" [--force]
#   ./create-action                       # interactive
#
set -u

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
TEMPLATES_DIR="$SCRIPT_DIR/templates"

TARGET_RE='^(button-[1-8](-longpress)?|dial-[1-4]-(cw|ccw|press|longpress)|touch-[1-4](-longpress|-swipe-(up|down|left|right))?|longswipe-(left|right))$'

TEMPLATE=""
TARGET=""
LABEL=""
FORCE=0

while [ $# -gt 0 ]; do
    case "$1" in
        --template) TEMPLATE="$2"; shift 2 ;;
        --target)   TARGET="$2"; shift 2 ;;
        --label)    LABEL="$2"; shift 2 ;;
        --force)    FORCE=1; shift ;;
        -h|--help)
            grep '^#' "$0" | sed 's/^#//'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

list_templates() {
    for t in "$TEMPLATES_DIR"/*.sh; do
        basename "$t" .sh
    done
}

# Interactive fallbacks when flags are absent.
if [ -z "$TEMPLATE" ]; then
    echo "Available templates:"
    list_templates | sed 's/^/  /'
    read -r -p "Template: " TEMPLATE
fi
if [ -z "$TARGET" ]; then
    echo "Target examples: button-3, dial-2-press, touch-1-swipe-up, longswipe-left"
    read -r -p "Target element: " TARGET
fi
if [ -z "$LABEL" ] && [ -t 0 ]; then
    read -r -p "Label (optional): " LABEL
fi

# Validate template.
TEMPLATE_FILE="$TEMPLATES_DIR/${TEMPLATE}.sh"
if [ ! -f "$TEMPLATE_FILE" ]; then
    echo "Unknown template: $TEMPLATE" >&2
    echo "Available: $(list_templates | tr '\n' ' ')" >&2
    exit 1
fi

# Validate target.
if ! [[ "$TARGET" =~ $TARGET_RE ]]; then
    echo "Invalid target: $TARGET" >&2
    echo "Expected e.g. button-3, dial-2-press, touch-1-swipe-up, longswipe-left" >&2
    exit 1
fi

# Map target prefix to directory.
case "$TARGET" in
    button-*)            DIR="$SCRIPT_DIR/buttons" ;;
    dial-*)              DIR="$SCRIPT_DIR/dials" ;;
    touch-*|longswipe-*) DIR="$SCRIPT_DIR/touchscreen" ;;
esac

SCRIPT="$DIR/${TARGET}.sh"

if [ -e "$SCRIPT" ] && [ "$FORCE" -ne 1 ]; then
    echo "Refusing to overwrite existing $SCRIPT (use --force)" >&2
    exit 1
fi

mkdir -p "$DIR"
cp -f "$TEMPLATE_FILE" "$SCRIPT"
chmod +x "$SCRIPT"

if [ -n "$LABEL" ]; then
    printf '%s' "$LABEL" > "$DIR/${TARGET}.txt"
fi

echo "Created $SCRIPT (from $TEMPLATE)"
[ -n "$LABEL" ] && echo "Label: $LABEL"
echo "Edit it, then the daemon hot-reloads on next trigger."
